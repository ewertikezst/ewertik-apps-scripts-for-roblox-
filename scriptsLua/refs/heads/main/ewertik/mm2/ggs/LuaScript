local CoreGui = game:GetService("CoreGui")
local FloatingIcon = Instance.new("ScreenGui")
FloatingIcon.Name = "FloatingEwertikIcon"
FloatingIcon.Parent = CoreGui
FloatingIcon.Enabled = false

local IconButton = Instance.new("ImageButton")
IconButton.Parent = FloatingIcon
IconButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
IconButton.BackgroundTransparency = 0.1
IconButton.Position = UDim2.new(0, 10, 0.5, -25)
IconButton.Size = UDim2.new(0, 50, 0, 50)
IconButton.Image = "rbxassetid://3926307971"
IconButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
IconButton.Draggable = true

local dragging, dragInput, dragStart, startPos
IconButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = IconButton.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
IconButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        IconButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
IconButton.MouseButton1Click:Connect(function()
    Library:ToggleUI()
    FloatingIcon.Enabled = false
end)

task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if State.AntiVoid and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Position.Y < -50 then hrp.CFrame = CFrame.new(0, 50, 0) end
        end
    end)

    RunService.Heartbeat:Connect(function()
        if State.AntiTrap and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then
                if hum.Sit then hum.Sit = false hum.Jump = true end
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Anchored then hrp.Anchored = false hum.Jump = true end
            end
        end
    end)

    local FOVCircle
    pcall(function() FOVCircle = Drawing.new("Circle") FOVCircle.Thickness = 1.5 FOVCircle.Color = Color3.fromRGB(0, 255, 255) FOVCircle.Filled = false end)
    RunService.RenderStepped:Connect(function()
        if FOVCircle then
            FOVCircle.Position = UserInputService.TouchEnabled and (Camera.ViewportSize / 2) or UserInputService:GetMouseLocation()
            FOVCircle.Radius = State.FOV
            FOVCircle.Visible = State.Aimbot or State.SilentAim
        end
    end)

    RunService.RenderStepped:Connect(function()
        if State.Aimbot then
            local closest, dist = nil, State.FOV
            local center = UserInputService.TouchEnabled and (Camera.ViewportSize / 2) or UserInputService:GetMouseLocation()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                    local screen, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                    if onScreen then
                        local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                        if d < dist then dist = d closest = p.Character.Head end
                    end
                end
            end
            if closest then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closest.Position), 0.2) end
        end
    end)

    local oldIndex
    pcall(function()
        oldIndex = hookmetamethod(game, "__index", function(self, method)
            if self == game.Players.LocalPlayer:GetMouse() and method == "Hit" and State.SilentAim then
                local closest, dist = nil, State.FOV
                local center = UserInputService.TouchEnabled and (Camera.ViewportSize / 2) or UserInputService:GetMouseLocation()
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                        local screen, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                        if onScreen then
                            local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                            if d < dist then dist = d closest = p.Character.Head end
                        end
                    end
                end
                if closest then return CFrame.new(closest.Position) end
            end
            return oldIndex(self, method)
        end)
    end)

    RunService.Stepped:Connect(function()
        if State.AntiFling and LocalPlayer.Character then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    for _, part in pairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end
    end)
end)

